pkgname=zohara-settings
pkgver=1.0.0
pkgrel=1
pkgdesc="Unified Zohara Settings application (Windows 11 style)"
arch=('any')
url="https://github.com/Zohaib8090/zohara"
license=('GPL3')
depends=('python-pyside6' 'polkit' 'python-dbus' 'python-gobject')
source=()

package() {
    # Install the helper service
    install -Dm755 "${srcdir}/../helper/zohara_settings_helper.py" "${pkgdir}/usr/lib/zohara-settings/zohara_settings_helper.py"
    install -Dm644 "${srcdir}/../helper/zohara-settings-helper.service" "${pkgdir}/usr/lib/systemd/system/zohara-settings-helper.service"
    
    # Install the polkit policy
    install -Dm644 "${srcdir}/../helper/org.zohara.settings.policy" "${pkgdir}/usr/share/polkit-1/actions/org.zohara.settings.policy"
    
    # Install the DBus config
    install -Dm644 "${srcdir}/../helper/org.zohara.settings.conf" "${pkgdir}/usr/share/dbus-1/system.d/org.zohara.settings.conf"
    
    # Install the app source
    mkdir -p "${pkgdir}/usr/lib/zohara-settings/src"
    cp -r "${srcdir}/../src/"* "${pkgdir}/usr/lib/zohara-settings/src/"
    
    # Install desktop file
    install -Dm644 "${srcdir}/../data/org.zohara.settings.desktop" "${pkgdir}/usr/share/applications/org.zohara.settings.desktop"
    
    # Create bin symlink/wrapper
    mkdir -p "${pkgdir}/usr/local/bin"
    echo '#!/bin/bash' > "${pkgdir}/usr/local/bin/zohara-settings"
    echo 'exec python /usr/lib/zohara-settings/src/main.py "$@"' >> "${pkgdir}/usr/local/bin/zohara-settings"
    chmod +x "${pkgdir}/usr/local/bin/zohara-settings"
}
