# remove from airootfs!
# Workaround for the xorg-server-common / xorg-server /usr/lib/Xorg
# dir-vs-file conflict that aborts the pacstrap transaction:
#   error: extract: not overwriting dir with file /usr/lib/Xorg
#
# xorg-server-common creates /usr/lib/xorg/ (lowercase, dir) and
# xorg-server installs /usr/lib/Xorg (capital, file). When both
# land in the same pacstrap transaction, AND some earlier package's
# install script creates /usr/lib/Xorg as a directory, pacman aborts.
#
# The /usr/lib/Xorg dir is sometimes created by earlier packages'
# .INSTALL scripts (e.g. as a location for Xorg modules). My hook
# fires at PreTransaction for ANY package install: if /usr/lib/Xorg
# exists as a directory, convert it to a placeholder file. The
# pacman-overwrite-xorg wrapper then injects --overwrite=/usr/lib/Xorg
# so any package trying to install the file on top is allowed.
#
# The directory contents (if any were there) are LOST in this
# workaround. In practice no Zohara package stores anything in
# /usr/lib/Xorg/ as a directory at ISO build time -- the canonical
# location is /usr/lib/xorg/ (lowercase).
#
# This hook is auto-removed from the final ISO by the
# zzzz99-remove-custom-hooks-from-airootfs.hook PostTransaction hook.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Ensure /usr/lib/Xorg is a file, not a directory, so xorg-server's install doesn't conflict...
When = PreTransaction
Depends = sh
Depends = coreutils
# If /usr/lib/Xorg exists and is a directory, remove it and create a
# placeholder file. The wrapper injects --overwrite=/usr/lib/Xorg
# which lets pacman replace this placeholder with the real file when
# xorg-server installs.
Exec = /bin/sh -c 'if [ -d /usr/lib/Xorg ] && [ ! -f /usr/lib/Xorg ]; then rm -rf /usr/lib/Xorg && touch /usr/lib/Xorg; fi'
