---
componentName:  zohara
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

strings:
    productName:         Zohara OS
    shortProductName:    Zohara
    version:             2026.08
    shortVersion:        2026.08
    versionedName:       Zohara OS 2026.08
    shortVersionedName:  Zohara 2026.08
    bootloaderEntryName: Zohara OS
    productUrl:          https://github.com/Zohaib8090/zohara
    supportUrl:          https://github.com/Zohaib8090/zohara
    knownIssuesUrl:      https://github.com/Zohaib8090/zohara
    releaseNotesUrl:     https://github.com/Zohaib8090/zohara
    donateUrl:           https://github.com/Zohaib8090/zohara

style:
   # A light installer: white side panel, dark step names, the current step in Zohara's blue.
   # (The key names are case-sensitive: lowercase or older names are ignored and the panel falls back to black with dark text.)
   SidebarBackground:        "#f4f5f7"
   SidebarText:              "#1e1e2e"
   SidebarTextCurrent:       "#ffffff"
   SidebarBackgroundCurrent: "#2f7de1"
images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI: 2
