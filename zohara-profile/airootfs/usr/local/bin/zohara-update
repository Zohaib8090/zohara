#!/usr/bin/env python3
"""
Zohara OS – System Updater
──────────────────────────
A clean GUI wrapper around `pacman -Syu` that shows live output.
Runs as root (pkexec) and handles the full update lifecycle.
"""

import sys
import os
import subprocess
import logging
from PyQt5.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout,
    QPushButton, QLabel, QTextEdit, QFrame, QProgressBar
)
from PyQt5.QtCore import Qt, QThread, pyqtSignal, QProcess
from PyQt5.QtGui import QFont, QTextCursor, QColor

LOG_FILE = '/tmp/zohara-update.log'
logging.basicConfig(filename=LOG_FILE, level=logging.DEBUG,
                    format='%(asctime)s [%(levelname)s] %(message)s')
log = logging.getLogger('zohara-update')

# ── Palette ───────────────────────────────────────────────────────────────
BG      = "#1e1e2e"
SURFACE = "#313244"
BORDER  = "#45475a"
TEXT    = "#cdd6f4"
SUBTEXT = "#a6adc8"
BLUE    = "#89b4fa"
GREEN   = "#a6e3a1"
RED     = "#f38ba8"
YELLOW  = "#f9e2af"

STYLE = f"""
QWidget {{ background-color: {BG}; color: {TEXT}; font-family: 'Inter', 'Noto Sans', sans-serif; font-size: 13px; }}
QTextEdit {{
    background-color: #11111b;
    color: #cdd6f4;
    border: 1px solid {BORDER};
    border-radius: 8px;
    font-family: 'Hack', 'JetBrains Mono', monospace;
    font-size: 12px;
    padding: 8px;
}}
QProgressBar {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 6px;
    height: 10px;
    text-align: center;
    color: transparent;
}}
QProgressBar::chunk {{
    background-color: {BLUE};
    border-radius: 6px;
}}
"""

def btn_style(color, disabled_color=None):
    dc = disabled_color or BORDER
    return f"""
        QPushButton {{
            background-color: {color};
            color: #1e1e2e;
            border-radius: 8px;
            padding: 10px 22px;
            font-weight: bold;
            font-size: 13px;
            border: none;
        }}
        QPushButton:hover {{ background-color: {color}dd; }}
        QPushButton:disabled {{ background-color: {dc}; color: {SUBTEXT}; }}
    """


# ── Update Worker Thread ──────────────────────────────────────────────────

class UpdateWorker(QThread):
    output   = pyqtSignal(str)
    finished = pyqtSignal(int)  # exit code

    def run(self):
        try:
            proc = subprocess.Popen(
                ['pacman', '-Syu', '--noconfirm', '--color', 'never'],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in proc.stdout:
                self.output.emit(line)
                log.debug(line.rstrip())
            proc.wait()
            self.finished.emit(proc.returncode)
        except Exception as e:
            self.output.emit(f"\n[ERROR] {e}\n")
            self.finished.emit(1)


# ── Main Window ───────────────────────────────────────────────────────────

class UpdateWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Zohara System Update")
        self.setMinimumSize(720, 520)
        self.setStyleSheet(STYLE)
        self.worker = None
        self._build()

    def _build(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 24, 28, 24)
        layout.setSpacing(16)

        # ── Header ───────────────────────────────────────────────────────
        hdr = QHBoxLayout()
        icon = QLabel("🔄")
        icon.setFont(QFont('Noto Color Emoji', 22))
        title = QLabel("System Update")
        title.setFont(QFont('Inter', 20, QFont.Bold))
        self.status_lbl = QLabel("Ready to check for updates.")
        self.status_lbl.setStyleSheet(f"color: {SUBTEXT}; font-size: 12px;")
        hdr.addWidget(icon)
        hdr.addSpacing(10)
        title_col = QVBoxLayout()
        title_col.addWidget(title)
        title_col.addWidget(self.status_lbl)
        hdr.addLayout(title_col)
        hdr.addStretch()
        layout.addLayout(hdr)

        # ── Info card ────────────────────────────────────────────────────
        card = QFrame()
        card.setStyleSheet(f"background-color: {SURFACE}; border: 1px solid {BORDER}; border-radius: 10px;")
        card_l = QHBoxLayout(card)
        card_l.setContentsMargins(16, 14, 16, 14)
        info = QLabel(
            "Zohara OS is <b>rolling release</b> — updates bring the latest packages directly from "
            "Arch Linux repositories. It is safe to update anytime."
        )
        info.setWordWrap(True)
        info.setStyleSheet(f"color: {SUBTEXT}; border: none; background: transparent;")
        card_l.addWidget(info)
        layout.addWidget(card)

        # ── Progress bar ─────────────────────────────────────────────────
        self.progress = QProgressBar()
        self.progress.setRange(0, 0)   # indeterminate
        self.progress.setFixedHeight(8)
        self.progress.setVisible(False)
        layout.addWidget(self.progress)

        # ── Log output ───────────────────────────────────────────────────
        self.log_box = QTextEdit()
        self.log_box.setReadOnly(True)
        self.log_box.setPlaceholderText("Update output will appear here...")
        layout.addWidget(self.log_box, 1)

        # ── Buttons ──────────────────────────────────────────────────────
        row = QHBoxLayout()
        row.setSpacing(12)

        self.btn_update = QPushButton("⬆  Check & Install Updates")
        self.btn_update.setStyleSheet(btn_style(BLUE))
        self.btn_update.setCursor(Qt.PointingHandCursor)
        self.btn_update.clicked.connect(self._start_update)

        self.btn_cancel = QPushButton("Cancel")
        self.btn_cancel.setStyleSheet(btn_style(RED))
        self.btn_cancel.setCursor(Qt.PointingHandCursor)
        self.btn_cancel.setEnabled(False)
        self.btn_cancel.clicked.connect(self._cancel)

        self.btn_close = QPushButton("Close")
        self.btn_close.setStyleSheet(btn_style(SURFACE))
        self.btn_close.setStyleSheet(f"""
            QPushButton {{
                background-color: {SURFACE};
                color: {TEXT};
                border: 1px solid {BORDER};
                border-radius: 8px;
                padding: 10px 22px;
                font-size: 13px;
            }}
            QPushButton:hover {{ background-color: {BORDER}; }}
        """)
        self.btn_close.setCursor(Qt.PointingHandCursor)
        self.btn_close.clicked.connect(self.close)

        row.addWidget(self.btn_update)
        row.addWidget(self.btn_cancel)
        row.addStretch()
        row.addWidget(self.btn_close)
        layout.addLayout(row)

    def _start_update(self):
        self.log_box.clear()
        self.btn_update.setEnabled(False)
        self.btn_cancel.setEnabled(True)
        self.progress.setVisible(True)
        self._set_status("Updating… this may take a few minutes.", YELLOW)
        self._append_log("==> Running: pacman -Syu --noconfirm\n\n")

        self.worker = UpdateWorker()
        self.worker.output.connect(self._append_log)
        self.worker.finished.connect(self._done)
        self.worker.start()

    def _cancel(self):
        if self.worker and self.worker.isRunning():
            self.worker.terminate()
            self._set_status("Update cancelled.", RED)
        self._reset_ui()

    def _done(self, code):
        self.progress.setVisible(False)
        if code == 0:
            self._set_status("✔ System is up to date!", GREEN)
            self._append_log("\n✔ Update complete. Your system is up to date.\n")
        else:
            self._set_status(f"✖ Update failed (exit code {code}). See log above.", RED)
            self._append_log(f"\n✖ Update process exited with code {code}.\n")
        self._reset_ui()

    def _reset_ui(self):
        self.btn_update.setEnabled(True)
        self.btn_cancel.setEnabled(False)
        self.progress.setVisible(False)

    def _set_status(self, msg, color=None):
        c = color or SUBTEXT
        self.status_lbl.setStyleSheet(f"color: {c}; font-size: 12px;")
        self.status_lbl.setText(msg)

    def _append_log(self, text):
        self.log_box.moveCursor(QTextCursor.End)
        self.log_box.insertPlainText(text)
        self.log_box.moveCursor(QTextCursor.End)


# ── Entry Point ───────────────────────────────────────────────────────────

if __name__ == '__main__':
    log.info("=== Zohara Update starting ===")
    if os.geteuid() != 0:
        os.execvp('pkexec', ['pkexec', sys.executable] + sys.argv)

    app = QApplication(sys.argv)
    app.setApplicationName("Zohara Update")
    win = UpdateWindow()
    win.show()
    sys.exit(app.exec_())
