#!/usr/bin/env python3
"""
Zohara OS – Updates Center
──────────────────────────
Dedicated system updater with separate sections for:
  • Zohara OS updates (OTA via zohara pacman repo)
  • Full system / package updates (pacman -Syu)
  • Kernel updates (linux-zen)
  • Driver updates (mesa, firmware, gpu packages)
"""

import sys, os, subprocess, re
from PyQt5.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QStackedWidget,
    QPushButton, QLabel, QTextEdit, QFrame, QProgressBar,
    QScrollArea, QSizePolicy, QListWidget, QListWidgetItem, QSplitter
)
from PyQt5.QtCore import Qt, QThread, pyqtSignal, QSize, QTimer
from PyQt5.QtGui import QFont, QTextCursor, QColor, QIcon

# ── Palette ────────────────────────────────────────────────────────────────
BG      = "#1e1e2e"
SURFACE = "#313244"
BORDER  = "#45475a"
TEXT    = "#cdd6f4"
SUBTEXT = "#a6adc8"
BLUE    = "#89b4fa"
GREEN   = "#a6e3a1"
RED     = "#f38ba8"
YELLOW  = "#f9e2af"
PURPLE  = "#cba6f7"
TEAL    = "#94e2d5"
MANTLE  = "#181825"

GLOBAL_STYLE = f"""
QWidget {{
    background-color: {BG};
    color: {TEXT};
    font-family: 'Inter', 'Noto Sans', sans-serif;
    font-size: 13px;
}}
QTextEdit {{
    background-color: {MANTLE};
    color: #cdd6f4;
    border: 1px solid {BORDER};
    border-radius: 8px;
    font-family: 'JetBrains Mono', 'Hack', monospace;
    font-size: 11px;
    padding: 8px;
}}
QProgressBar {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}}
QProgressBar::chunk {{ background-color: {BLUE}; border-radius: 4px; }}
QScrollBar:vertical {{
    background: {MANTLE}; width: 8px; border-radius: 4px;
}}
QScrollBar::handle:vertical {{
    background: {BORDER}; border-radius: 4px; min-height: 20px;
}}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
"""

# ── Helper: generic worker thread ──────────────────────────────────────────
class CmdWorker(QThread):
    output   = pyqtSignal(str)
    finished = pyqtSignal(int)

    def __init__(self, cmd):
        super().__init__()
        self.cmd = cmd
        self._proc = None

    def run(self):
        try:
            self._proc = subprocess.Popen(
                self.cmd, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, text=True, bufsize=1
            )
            for line in self._proc.stdout:
                self.output.emit(line)
            self._proc.wait()
            self.finished.emit(self._proc.returncode)
        except Exception as e:
            self.output.emit(f"\n[ERROR] {e}\n")
            self.finished.emit(1)

    def kill(self):
        if self._proc:
            self._proc.kill()


# ── Helper: check-only worker (returns stdout) ─────────────────────────────
class CheckWorker(QThread):
    result = pyqtSignal(list)  # list of (name, current_ver, new_ver) tuples

    def __init__(self, pkgs_filter=None):
        super().__init__()
        self.pkgs_filter = pkgs_filter  # None = all, list = filter by name

    def run(self):
        try:
            subprocess.run(['pacman', '-Sy', '--noconfirm'], capture_output=True)
            r = subprocess.run(['pacman', '-Qu'], capture_output=True, text=True)
            updates = []
            for line in r.stdout.splitlines():
                # format: "pkgname current_ver -> new_ver"
                m = re.match(r'^(\S+)\s+(\S+)\s+->\s+(\S+)', line)
                if m:
                    name, cur, new = m.group(1), m.group(2), m.group(3)
                    if self.pkgs_filter is None or any(f in name for f in self.pkgs_filter):
                        updates.append((name, cur, new))
            self.result.emit(updates)
        except Exception as e:
            self.result.emit([])


# ── Reusable update panel ──────────────────────────────────────────────────
class UpdatePanel(QWidget):
    """Generic update card: check → show list → install."""

    def __init__(self, title, icon, description, color,
                 install_cmd, pkg_filter=None, parent=None):
        super().__init__(parent)
        self.title = title
        self.color = color
        self.install_cmd = install_cmd
        self.pkg_filter = pkg_filter
        self._worker = None
        self._updates = []
        self._build(icon, description)

    def _build(self, icon, description):
        root = QVBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(12)

        # Card
        card = QFrame()
        card.setStyleSheet(
            f"QFrame {{ background-color: {SURFACE}; border: 1px solid {BORDER};"
            f" border-radius: 12px; }} QLabel {{ border: none; background: transparent; }}"
        )
        card_l = QVBoxLayout(card)
        card_l.setContentsMargins(20, 16, 20, 16)
        card_l.setSpacing(10)

        # Header row
        hdr = QHBoxLayout()
        ico_lbl = QLabel(icon)
        ico_lbl.setFont(QFont('Noto Color Emoji', 20))
        ico_lbl.setFixedWidth(36)
        title_lbl = QLabel(self.title)
        title_lbl.setFont(QFont('Inter', 14, QFont.Bold))
        self.badge = QLabel("Checking…")
        self.badge.setStyleSheet(
            f"background-color: {self.color}22; color: {self.color};"
            f" border: 1px solid {self.color}44; border-radius: 10px;"
            f" padding: 2px 10px; font-size: 11px; font-weight: bold;"
        )
        hdr.addWidget(ico_lbl)
        hdr.addWidget(title_lbl)
        hdr.addStretch()
        hdr.addWidget(self.badge)
        card_l.addLayout(hdr)

        # Description
        desc_lbl = QLabel(description)
        desc_lbl.setWordWrap(True)
        desc_lbl.setStyleSheet(f"color: {SUBTEXT}; font-size: 12px;")
        card_l.addWidget(desc_lbl)

        # Progress bar
        self.progress = QProgressBar()
        self.progress.setRange(0, 0)
        self.progress.setFixedHeight(4)
        self.progress.setVisible(False)
        card_l.addWidget(self.progress)

        # Updates list (hidden until populated)
        self.updates_list = QTextEdit()
        self.updates_list.setReadOnly(True)
        self.updates_list.setFixedHeight(100)
        self.updates_list.setVisible(False)
        self.updates_list.setStyleSheet(
            f"background-color: {MANTLE}; border: 1px solid {BORDER};"
            f" border-radius: 6px; font-size: 11px; padding: 6px;"
        )
        card_l.addWidget(self.updates_list)

        # Log output
        self.log = QTextEdit()
        self.log.setReadOnly(True)
        self.log.setFixedHeight(120)
        self.log.setVisible(False)
        card_l.addWidget(self.log)

        # Buttons
        btn_row = QHBoxLayout()
        self.btn_check = QPushButton("  Check")
        self.btn_check.setStyleSheet(self._btn_style(BLUE))
        self.btn_check.setCursor(Qt.PointingHandCursor)
        self.btn_check.clicked.connect(self._check)

        self.btn_install = QPushButton("⬆  Install")
        self.btn_install.setStyleSheet(self._btn_style(self.color))
        self.btn_install.setCursor(Qt.PointingHandCursor)
        self.btn_install.setEnabled(False)
        self.btn_install.clicked.connect(self._install)

        self.btn_cancel = QPushButton("Cancel")
        self.btn_cancel.setStyleSheet(self._btn_style(RED))
        self.btn_cancel.setCursor(Qt.PointingHandCursor)
        self.btn_cancel.setEnabled(False)
        self.btn_cancel.clicked.connect(self._cancel)

        btn_row.addWidget(self.btn_check)
        btn_row.addWidget(self.btn_install)
        btn_row.addWidget(self.btn_cancel)
        btn_row.addStretch()
        card_l.addLayout(btn_row)

        root.addWidget(card)

    def _btn_style(self, color):
        return f"""
            QPushButton {{
                background-color: {color}22;
                color: {color};
                border: 1px solid {color}55;
                border-radius: 7px;
                padding: 7px 18px;
                font-weight: bold;
                font-size: 12px;
            }}
            QPushButton:hover {{ background-color: {color}44; }}
            QPushButton:disabled {{ background-color: {SURFACE}; color: {BORDER}; border-color: {BORDER}; }}
        """

    def _check(self):
        self.badge.setText("Checking…")
        self.progress.setVisible(True)
        self.btn_check.setEnabled(False)
        self.btn_install.setEnabled(False)
        self.updates_list.setVisible(False)
        self.log.setVisible(False)

        self._check_worker = CheckWorker(self.pkg_filter)
        self._check_worker.result.connect(self._on_check_result)
        self._check_worker.start()

    def _on_check_result(self, updates):
        self.progress.setVisible(False)
        self.btn_check.setEnabled(True)
        self._updates = updates

        if updates:
            self.badge.setText(f"{len(updates)} update{'s' if len(updates)>1 else ''} available")
            self.badge.setStyleSheet(
                f"background-color: {self.color}22; color: {self.color};"
                f" border: 1px solid {self.color}44; border-radius: 10px;"
                f" padding: 2px 10px; font-size: 11px; font-weight: bold;"
            )
            lines = "\n".join(f"  {n}   {c} → {v}" for n, c, v in updates)
            self.updates_list.setPlainText(lines)
            self.updates_list.setVisible(True)
            self.btn_install.setEnabled(True)
        else:
            self.badge.setText("Up to date ✓")
            self.badge.setStyleSheet(
                f"background-color: {GREEN}22; color: {GREEN};"
                f" border: 1px solid {GREEN}44; border-radius: 10px;"
                f" padding: 2px 10px; font-size: 11px; font-weight: bold;"
            )

    def _install(self):
        self.log.clear()
        self.log.setVisible(True)
        self.btn_install.setEnabled(False)
        self.btn_check.setEnabled(False)
        self.btn_cancel.setEnabled(True)
        self.progress.setVisible(True)
        self.badge.setText("Installing…")

        self._worker = CmdWorker(self.install_cmd)
        self._worker.output.connect(self._append_log)
        self._worker.finished.connect(self._done)
        self._worker.start()

    def _cancel(self):
        if self._worker:
            self._worker.kill()
        self.badge.setText("Cancelled")
        self._reset()

    def _done(self, code):
        self.progress.setVisible(False)
        if code == 0:
            self.badge.setText("Done ✓")
            self._append_log("\n✔ Complete!\n")
        else:
            self.badge.setText(f"Failed (code {code})")
            self._append_log(f"\n✖ Failed with exit code {code}\n")
        self._reset()

    def _reset(self):
        self.btn_check.setEnabled(True)
        self.btn_install.setEnabled(False)
        self.btn_cancel.setEnabled(False)
        self.progress.setVisible(False)

    def _append_log(self, text):
        self.log.moveCursor(QTextCursor.End)
        self.log.insertPlainText(text)
        self.log.moveCursor(QTextCursor.End)

    def auto_check(self):
        QTimer.singleShot(200, self._check)


# ── Main Window ────────────────────────────────────────────────────────────
class UpdatesCenter(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Zohara Updates Center")
        self.setMinimumSize(780, 640)
        self.setStyleSheet(GLOBAL_STYLE)
        self._build()
        QTimer.singleShot(500, self._auto_check_all)

    def _build(self):
        root = QVBoxLayout(self)
        root.setContentsMargins(28, 24, 28, 24)
        root.setSpacing(18)

        # ── Header ─────────────────────────────────────────────────────
        hdr = QHBoxLayout()
        title = QLabel("Zohara Updates Center")
        title.setFont(QFont('Inter', 22, QFont.Bold))
        sub = QLabel("Keep your OS, kernel, and drivers up to date")
        sub.setStyleSheet(f"color: {SUBTEXT}; font-size: 12px;")
        title_col = QVBoxLayout()
        title_col.setSpacing(2)
        title_col.addWidget(title)
        title_col.addWidget(sub)
        hdr.addLayout(title_col)
        hdr.addStretch()

        btn_check_all = QPushButton("  Check All")
        btn_check_all.setStyleSheet(f"""
            QPushButton {{
                background-color: {BLUE}22; color: {BLUE};
                border: 1px solid {BLUE}55; border-radius: 8px;
                padding: 9px 20px; font-weight: bold; font-size: 13px;
            }}
            QPushButton:hover {{ background-color: {BLUE}44; }}
        """)
        btn_check_all.setCursor(Qt.PointingHandCursor)
        btn_check_all.clicked.connect(self._auto_check_all)
        hdr.addWidget(btn_check_all)
        root.addLayout(hdr)

        # Divider
        div = QFrame()
        div.setFrameShape(QFrame.HLine)
        div.setStyleSheet(f"color: {BORDER};")
        root.addWidget(div)

        # ── Scroll area with panels ─────────────────────────────────────
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setStyleSheet("background: transparent;")

        container = QWidget()
        container.setStyleSheet("background: transparent;")
        clo = QVBoxLayout(container)
        clo.setContentsMargins(0, 0, 8, 0)
        clo.setSpacing(16)

        # 1. Zohara OS Updates (OTA)
        self.panel_zohara = UpdatePanel(
            title="Zohara OS Updates",
            icon="🔷",
            description="Official Zohara OS updates: system configs, themes, and built-in apps delivered via the Zohara release channel.",
            color=PURPLE,
            install_cmd=['pacman', '-Syu', '--noconfirm', 'zohara-system'],
            pkg_filter=['zohara']
        )

        # 2. System Package Updates (all)
        self.panel_system = UpdatePanel(
            title="System & Application Updates",
            icon="🔄",
            description="Full rolling-release update from Arch Linux and Chaotic-AUR repositories. Keeps all installed packages current.",
            color=BLUE,
            install_cmd=['pacman', '-Syu', '--noconfirm'],
            pkg_filter=None
        )

        # 3. Kernel Updates
        self.panel_kernel = UpdatePanel(
            title="Kernel Updates",
            icon="⚡",
            description="Updates the Linux Zen kernel powering Zohara OS. A reboot is required to apply kernel changes.",
            color=YELLOW,
            install_cmd=['pacman', '-Syu', '--noconfirm', 'linux-zen', 'linux-zen-headers'],
            pkg_filter=['linux-zen', 'linux-firmware']
        )

        # 4. Driver Updates
        self.panel_drivers = UpdatePanel(
            title="Driver & Firmware Updates",
            icon="🔧",
            description="Updates GPU drivers (Mesa, NVIDIA, AMDGPU), firmware packages, and hardware support modules.",
            color=TEAL,
            install_cmd=['pacman', '-Syu', '--noconfirm',
                         'mesa', 'lib32-mesa', 'vulkan-radeon', 'vulkan-intel',
                         'libva-mesa-driver', 'linux-firmware'],
            pkg_filter=['mesa', 'nvidia', 'amdgpu', 'firmware', 'vulkan',
                        'libva', 'libdrm', 'xf86-video']
        )

        for panel in [self.panel_zohara, self.panel_system, self.panel_kernel, self.panel_drivers]:
            clo.addWidget(panel)

        clo.addStretch()
        scroll.setWidget(container)
        root.addWidget(scroll, 1)

        # ── Footer ─────────────────────────────────────────────────────
        footer = QHBoxLayout()
        self.status_lbl = QLabel("Ready.")
        self.status_lbl.setStyleSheet(f"color: {SUBTEXT}; font-size: 11px;")
        btn_close = QPushButton("Close")
        btn_close.setStyleSheet(f"""
            QPushButton {{
                background-color: transparent; color: {SUBTEXT};
                border: 1px solid {BORDER}; border-radius: 7px;
                padding: 7px 20px; font-size: 12px;
            }}
            QPushButton:hover {{ background-color: {SURFACE}; color: {TEXT}; }}
        """)
        btn_close.setCursor(Qt.PointingHandCursor)
        btn_close.clicked.connect(self.close)
        footer.addWidget(self.status_lbl)
        footer.addStretch()
        footer.addWidget(btn_close)
        root.addLayout(footer)

    def _auto_check_all(self):
        for panel in [self.panel_zohara, self.panel_system, self.panel_kernel, self.panel_drivers]:
            panel.auto_check()


# ── Entry Point ────────────────────────────────────────────────────────────
if __name__ == '__main__':
    if os.geteuid() != 0:
        os.execvp('pkexec', ['pkexec', sys.executable] + sys.argv)

    app = QApplication(sys.argv)
    app.setApplicationName("Zohara Updates Center")
    app.setApplicationDisplayName("Zohara Updates Center")
    win = UpdatesCenter()
    win.show()
    sys.exit(app.exec_())
