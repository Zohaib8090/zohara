#!/usr/bin/env python3
"""
Zohara OS Migration Tool
─────────────────────────
Incremental move-verify-delete migration for low-storage environments.
Files are moved one at a time, checksummed, and only deleted from the
source after the copy is verified. This ensures migration can succeed
even when the disk is >50% full.
"""

import sys
import os
import hashlib
import shutil
import subprocess
from pathlib import Path
from PyQt5.QtWidgets import (QApplication, QWidget, QVBoxLayout, QPushButton,
                              QLabel, QListWidget, QMessageBox, QProgressBar,
                              QTextEdit, QStackedWidget)
from PyQt5.QtCore import Qt, QThread, pyqtSignal
from PyQt5.QtGui import QFont

# ──────────────────────────────────────────────
# Debian -> Arch package translation table
# ──────────────────────────────────────────────
DEB_TO_ARCH = {
    "python3": "python", "python3-pip": "python-pip",
    "python3-dev": "python", "python3-venv": "python",
    "libqt5core5a": "qt5-base", "libqt5gui5": "qt5-base",
    "libgtk-3-0": "gtk3", "libgtk-4-1": "gtk4",
    "libnss3": "nss", "ffmpeg": "ffmpeg", "vlc": "vlc",
    "gimp": "gimp", "inkscape": "inkscape",
    "libreoffice-common": "libreoffice-still",
    "libreoffice-core": "libreoffice-still",
    "libreoffice-writer": "libreoffice-still",
    "libreoffice-calc": "libreoffice-still",
    "libreoffice-impress": "libreoffice-still",
    "git": "git", "curl": "curl", "wget": "wget",
    "vim": "vim", "nano": "nano", "htop": "htop", "btop": "btop",
    "neofetch": "fastfetch", "chromium-browser": "chromium",
    "google-chrome-stable": "google-chrome", "firefox": "firefox",
    "thunderbird": "thunderbird", "code": "code",
    "discord": "discord", "telegram-desktop": "telegram-desktop",
    "obs-studio": "obs-studio", "audacity": "audacity",
    "krita": "krita", "kdenlive": "kdenlive",
    "docker": "docker", "docker-ce": "docker",
    "nodejs": "nodejs", "npm": "npm",
    "default-jdk": "jdk-openjdk", "openjdk-11-jdk": "jdk11-openjdk",
    "openjdk-17-jdk": "jdk17-openjdk",
    "mysql-server": "mariadb", "postgresql": "postgresql",
    "nginx": "nginx", "openssh-server": "openssh",
    "ufw": "ufw", "wine": "wine", "steam": "steam",
    "lutris": "lutris", "flatpak": "flatpak",
    "snap": None,  # No snap on Arch
}

EXCLUDED_DEB_PREFIXES = [
    "lib", "linux-image", "linux-headers", "grub", "plymouth",
    "xserver", "xorg", "fonts-", "tzdata", "locales", "keyboard",
    "console-", "initramfs", "apt", "dpkg", "debconf", "base-"
]


def is_excluded(pkg_name):
    return any(pkg_name.startswith(p) for p in EXCLUDED_DEB_PREFIXES)


def sha256_file(filepath, chunk_size=65536):
    """Compute SHA-256 hash of a file without loading it entirely into memory."""
    h = hashlib.sha256()
    with open(filepath, 'rb') as f:
        while True:
            chunk = f.read(chunk_size)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def human_size(nbytes):
    """Convert byte count to human-readable string."""
    for unit in ['B', 'KB', 'MB', 'GB']:
        if nbytes < 1024:
            return f"{nbytes:.1f} {unit}"
        nbytes /= 1024
    return f"{nbytes:.1f} TB"


class MigrationWorker(QThread):
    """
    Incremental Move-Verify-Delete migration worker.

    Instead of copying everything first, this worker:
      1. Walks the source /home tree file by file.
      2. Copies each file to the destination.
      3. Computes SHA-256 of both source and destination.
      4. If hashes match → deletes the source file immediately.
      5. If hashes don't match → keeps the source, logs the error.

    This means the migration only ever needs enough free space for
    ONE file at a time, making it safe on nearly-full disks.
    """
    progress = pyqtSignal(int, str)           # (percent, message)
    file_progress = pyqtSignal(str, str)      # (filename, status)
    finished = pyqtSignal(list, list, list)    # (installed_pkgs, unmapped_pkgs, failed_files)

    def __init__(self, dev_path):
        super().__init__()
        self.dev_path = dev_path
        self.mount_point = '/mnt/zohara_old'

    def run(self):
        failed_files = []
        try:
            # ── Phase 1: Mount ──
            self.progress.emit(2, "Mounting old OS partition...")
            os.makedirs(self.mount_point, exist_ok=True)
            subprocess.run(['mount', self.dev_path, self.mount_point], check=True)

            # ── Phase 2: Scan packages ──
            self.progress.emit(5, "Scanning installed packages on old OS...")
            deb_packages = self.get_deb_packages()

            self.progress.emit(10, "Translating Debian → Arch packages...")
            installed, unmapped = self.translate_packages(deb_packages)

            # ── Phase 3: Incremental file migration ──
            self.progress.emit(15, "Scanning files to migrate...")
            old_home = Path(self.mount_point) / 'home'

            if old_home.exists():
                all_files = []
                for root, dirs, files in os.walk(str(old_home)):
                    for fname in files:
                        full = os.path.join(root, fname)
                        try:
                            size = os.path.getsize(full)
                        except OSError:
                            size = 0
                        all_files.append((full, size))

                total_files = len(all_files)
                total_bytes = sum(s for _, s in all_files)
                migrated_bytes = 0

                self.progress.emit(15, f"Migrating {total_files} files ({human_size(total_bytes)})...")

                for i, (src_path, fsize) in enumerate(all_files):
                    # Calculate destination path
                    rel_path = os.path.relpath(src_path, str(old_home))
                    dst_path = os.path.join('/home', rel_path)

                    short_name = rel_path if len(rel_path) < 60 else '…' + rel_path[-57:]
                    self.file_progress.emit(short_name, "copying")

                    try:
                        # 1. Create destination directory
                        os.makedirs(os.path.dirname(dst_path), exist_ok=True)

                        # 2. Copy file (preserving metadata)
                        shutil.copy2(src_path, dst_path)

                        # 3. Verify: compare SHA-256 checksums
                        src_hash = sha256_file(src_path)
                        dst_hash = sha256_file(dst_path)

                        if src_hash == dst_hash:
                            # 4. Hashes match → safe to delete source
                            os.remove(src_path)
                            self.file_progress.emit(short_name, "✓ verified & deleted")
                        else:
                            # Hash mismatch — keep source, log failure
                            os.remove(dst_path)  # remove bad copy
                            failed_files.append(f"{rel_path}  [checksum mismatch]")
                            self.file_progress.emit(short_name, "✗ checksum mismatch")

                    except PermissionError:
                        failed_files.append(f"{rel_path}  [permission denied]")
                        self.file_progress.emit(short_name, "✗ permission denied")
                    except OSError as e:
                        failed_files.append(f"{rel_path}  [{str(e)}]")
                        self.file_progress.emit(short_name, f"✗ {e}")

                    migrated_bytes += fsize
                    pct = 15 + int((migrated_bytes / max(total_bytes, 1)) * 55)
                    self.progress.emit(min(pct, 70),
                        f"File {i+1}/{total_files} — {human_size(migrated_bytes)}/{human_size(total_bytes)}")

                # Clean up empty directories left behind in old /home
                self.progress.emit(72, "Cleaning empty directories on source...")
                for root, dirs, files in os.walk(str(old_home), topdown=False):
                    for d in dirs:
                        dirpath = os.path.join(root, d)
                        try:
                            os.rmdir(dirpath)  # only removes if empty
                        except OSError:
                            pass

            # ── Phase 4: Install Arch packages ──
            self.progress.emit(75, f"Installing {len(installed)} equivalent Arch packages...")
            self.install_arch_packages(installed)

            # ── Phase 5: Delete remaining old OS system files ──
            self.progress.emit(90, "Deleting old OS system files...")
            self.delete_old_os_system()

            # ── Phase 6: Unmount ──
            self.progress.emit(95, "Unmounting old partition...")
            subprocess.run(['umount', self.mount_point], check=True)

            self.progress.emit(100, "Migration complete!")
            self.finished.emit(installed, unmapped, failed_files)

        except Exception as e:
            try:
                subprocess.run(['umount', self.mount_point])
            except Exception:
                pass
            self.progress.emit(0, f"Fatal error: {str(e)}")
            self.finished.emit([], [str(e)], failed_files)

    def get_deb_packages(self):
        dpkg_status = os.path.join(self.mount_point, 'var/lib/dpkg/status')
        packages = []
        if not os.path.exists(dpkg_status):
            return packages
        with open(dpkg_status, 'r', errors='replace') as f:
            content = f.read()
        for block in content.split('\n\n'):
            pkg_name = None
            is_installed = False
            for line in block.split('\n'):
                if line.startswith('Package:'):
                    pkg_name = line.split(':', 1)[1].strip()
                if line.startswith('Status:') and 'installed' in line:
                    is_installed = True
            if pkg_name and is_installed and not is_excluded(pkg_name):
                packages.append(pkg_name)
        return packages

    def translate_packages(self, deb_packages):
        installed = []
        unmapped = []
        for pkg in deb_packages:
            if pkg in DEB_TO_ARCH:
                arch_pkg = DEB_TO_ARCH[pkg]
                if arch_pkg is not None:
                    installed.append(arch_pkg)
                else:
                    unmapped.append(f"{pkg}  →  [No Arch equivalent — snap/ubuntu-specific]")
            else:
                unmapped.append(f"{pkg}  →  [Not in translation table]")
        return list(set(installed)), unmapped

    def install_arch_packages(self, packages):
        if packages:
            subprocess.run(
                ['pacman', '-S', '--noconfirm', '--needed'] + packages,
                capture_output=True
            )

    def delete_old_os_system(self):
        """Delete old OS system directories (not /home, that was already migrated)."""
        dirs_to_delete = [
            'bin', 'boot', 'etc', 'lib', 'lib32', 'lib64',
            'opt', 'root', 'sbin', 'srv', 'usr', 'var'
        ]
        for d in dirs_to_delete:
            target = os.path.join(self.mount_point, d)
            if os.path.exists(target):
                shutil.rmtree(target, ignore_errors=True)


# ══════════════════════════════════════════════
#  GUI
# ══════════════════════════════════════════════

class MigrationTool(QWidget):
    def __init__(self):
        super().__init__()
        self.is_live = os.path.exists('/run/archiso')
        self.stack = QStackedWidget()
        self.initUI()

    def initUI(self):
        self.setWindowTitle('Zohara OS Migration Wizard')
        self.setFixedSize(680, 520)
        self.setStyleSheet("background-color: #1e1e2e; color: #cdd6f4;")
        self.setFont(QFont('Inter', 11))

        main_layout = QVBoxLayout()
        main_layout.addWidget(self.stack)
        self.setLayout(main_layout)

        if self.is_live:
            self.stack.addWidget(self.build_live_page())
        else:
            self.stack.addWidget(self.build_select_page())     # 0
            self.stack.addWidget(self.build_progress_page())   # 1
            self.stack.addWidget(self.build_results_page())    # 2

    # ──────────────── Live USB page ────────────────
    def build_live_page(self):
        page = QWidget()
        layout = QVBoxLayout()
        layout.setAlignment(Qt.AlignCenter)
        layout.setSpacing(20)

        title = QLabel('Zohara OS Migration')
        title.setFont(QFont('Inter', 20, QFont.Bold))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)

        info = QLabel(
            "You're currently on the Live USB.\n\n"
            "Install Zohara OS on your disk first, then boot into it.\n"
            "After booting, run this Migration Tool again to:\n\n"
            "  ✔  Move your files incrementally (safe for low storage)\n"
            "  ✔  Verify every file with SHA-256 checksums\n"
            "  ✔  Free space as it goes — no extra disk needed\n"
            "  ✔  Install equivalent Arch apps for your Debian apps\n"
            "  ✔  Delete the old OS after successful migration\n"
            "  ✔  Show a full report of any apps that couldn't be found"
        )
        info.setWordWrap(True)
        info.setFont(QFont('Inter', 12))
        layout.addWidget(info)

        btn = QPushButton('Launch Installer Now')
        btn.setStyleSheet(self.btn_style('#89b4fa'))
        btn.clicked.connect(self.launch_calamares)
        layout.addWidget(btn)

        page.setLayout(layout)
        return page

    # ──────────────── Partition select page ────────────────
    def build_select_page(self):
        page = QWidget()
        layout = QVBoxLayout()
        layout.setSpacing(15)

        title = QLabel('Select your old OS partition to migrate:')
        title.setFont(QFont('Inter', 14, QFont.Bold))
        layout.addWidget(title)

        note = QLabel(
            "⚠  Files are moved incrementally: copy → verify checksum → delete source.\n"
            "    This works safely even on nearly-full disks.\n"
            "    After success, the old OS system files will be permanently deleted."
        )
        note.setStyleSheet("color: #f38ba8;")
        note.setWordWrap(True)
        layout.addWidget(note)

        self.part_list = QListWidget()
        self.part_list.setStyleSheet(
            "background-color: #313244; border-radius: 5px; padding: 5px; font-size: 13px;"
        )
        self.populate_partitions()
        layout.addWidget(self.part_list)

        btn = QPushButton('Start Migration →')
        btn.setStyleSheet(self.btn_style('#a6e3a1'))
        btn.clicked.connect(self.start_migration)
        layout.addWidget(btn)

        page.setLayout(layout)
        return page

    # ──────────────── Progress page ────────────────
    def build_progress_page(self):
        page = QWidget()
        layout = QVBoxLayout()
        layout.setSpacing(12)

        title = QLabel('Migration in Progress...')
        title.setFont(QFont('Inter', 16, QFont.Bold))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)

        self.progress_bar = QProgressBar()
        self.progress_bar.setStyleSheet("""
            QProgressBar { background: #313244; border-radius: 5px; height: 20px; }
            QProgressBar::chunk { background: #89b4fa; border-radius: 5px; }
        """)
        layout.addWidget(self.progress_bar)

        self.progress_label = QLabel('Starting...')
        self.progress_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.progress_label)

        layout.addWidget(QLabel('File activity:'))
        self.file_log = QTextEdit()
        self.file_log.setReadOnly(True)
        self.file_log.setMaximumHeight(200)
        self.file_log.setStyleSheet(
            "background-color: #11111b; border-radius: 5px; font-family: monospace; font-size: 11px; color: #a6adc8;"
        )
        layout.addWidget(self.file_log)

        page.setLayout(layout)
        return page

    # ──────────────── Results page ────────────────
    def build_results_page(self):
        page = QWidget()
        layout = QVBoxLayout()
        layout.setSpacing(12)

        self.result_title = QLabel('Migration Complete!')
        self.result_title.setFont(QFont('Inter', 16, QFont.Bold))
        self.result_title.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.result_title)

        layout.addWidget(QLabel('Unmapped packages (no Arch equivalent found):'))

        self.unmapped_list = QTextEdit()
        self.unmapped_list.setReadOnly(True)
        self.unmapped_list.setStyleSheet(
            "background-color: #313244; border-radius: 5px; color: #f9e2af; font-size: 12px;"
        )
        layout.addWidget(self.unmapped_list)

        self.failed_label = QLabel('')
        self.failed_label.setStyleSheet("color: #f38ba8;")
        self.failed_label.setWordWrap(True)
        layout.addWidget(self.failed_label)

        self.failed_list = QTextEdit()
        self.failed_list.setReadOnly(True)
        self.failed_list.setMaximumHeight(120)
        self.failed_list.setStyleSheet(
            "background-color: #313244; border-radius: 5px; color: #f38ba8; font-size: 12px;"
        )
        self.failed_list.hide()
        layout.addWidget(self.failed_list)

        btn_close = QPushButton('Done — Reboot Now')
        btn_close.setStyleSheet(self.btn_style('#89b4fa'))
        btn_close.clicked.connect(self.reboot)
        layout.addWidget(btn_close)

        page.setLayout(layout)
        return page

    # ──────────────── Helpers ────────────────
    def btn_style(self, color):
        return f"""
            QPushButton {{
                background-color: {color}; color: #1e1e2e;
                border-radius: 8px; padding: 12px;
                font-size: 14px; font-weight: bold;
            }}
            QPushButton:hover {{ background-color: {color}cc; }}
        """

    def populate_partitions(self):
        try:
            output = subprocess.check_output(
                ['lsblk', '-lno', 'NAME,FSTYPE,SIZE,MOUNTPOINT'], text=True
            )
            for line in output.strip().split('\n'):
                parts = line.split()
                if len(parts) >= 2 and parts[1] in ('ext4', 'btrfs', 'xfs'):
                    mount = parts[3] if len(parts) > 3 else ''
                    if mount != '/':
                        self.part_list.addItem(line.strip())
        except Exception:
            pass

    def launch_calamares(self):
        cmd = ['calamares'] if os.geteuid() == 0 else ['pkexec', 'calamares']
        subprocess.Popen(cmd)
        self.close()

    def reboot(self):
        subprocess.Popen(['reboot'])
        self.close()

    def start_migration(self):
        selected = self.part_list.currentItem()
        if not selected:
            QMessageBox.warning(self, "Error", "Please select a partition first.")
            return

        part_name = selected.text().split()[0]
        dev_path = f"/dev/{part_name}"

        confirm = QMessageBox.question(
            self, "Confirm Migration",
            f"This will incrementally migrate all data from {dev_path}.\n\n"
            f"Each file is: copied → SHA-256 verified → source deleted.\n"
            f"Old OS system files will be permanently removed after success.\n\n"
            "Continue?",
            QMessageBox.Yes | QMessageBox.No
        )

        if confirm == QMessageBox.Yes:
            self.stack.setCurrentIndex(1)
            self.worker = MigrationWorker(dev_path)
            self.worker.progress.connect(self.on_progress)
            self.worker.file_progress.connect(self.on_file_progress)
            self.worker.finished.connect(self.on_finished)
            self.worker.start()

    def on_progress(self, value, message):
        self.progress_bar.setValue(value)
        self.progress_label.setText(message)

    def on_file_progress(self, filename, status):
        self.file_log.append(f"{status}  {filename}")
        # Auto-scroll to bottom
        sb = self.file_log.verticalScrollBar()
        sb.setValue(sb.maximum())

    def on_finished(self, installed, unmapped, failed_files):
        self.stack.setCurrentIndex(2)

        inst_count = len(installed)
        unmap_count = len(unmapped)
        fail_count = len(failed_files)

        self.result_title.setText(
            f"Migration Complete!\n"
            f"{inst_count} apps installed  •  {unmap_count} apps not found  •  {fail_count} files failed"
        )

        if unmapped:
            self.unmapped_list.setPlainText('\n'.join(unmapped))
        else:
            self.unmapped_list.setPlainText("All packages were successfully mapped! 🎉")

        if failed_files:
            self.failed_label.setText(
                f"⚠ {fail_count} file(s) could not be migrated (kept on source):"
            )
            self.failed_list.setPlainText('\n'.join(failed_files))
            self.failed_list.show()


if __name__ == '__main__':
    app = QApplication(sys.argv)
    ex = MigrationTool()
    ex.show()
    sys.exit(app.exec_())
