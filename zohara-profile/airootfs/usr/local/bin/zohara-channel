#!/usr/bin/env bash
# zohara-channel -- switch between stable/beta/alpha update channels
#
# The Zohara Packages repo at https://github.com/Zohaib8090/zohara-packages
# has three release channels, each as a separate GitHub release with its own
# zohara.db. This script:
#
#   1. Reads / writes the channel setting to /etc/zohara/channel
#   2. Updates /etc/pacman.conf to enable only the matching [zohara-*] repo
#   3. Calls pacman -Sy to refresh the package database
#
# Usage:
#   zohara-channel                  # show current channel
#   zohara-channel set stable       # default; LTS / production
#   zohara-channel set beta         # weekly builds, may be buggy
#   zohara-channel set alpha        # daily / manual, expect breakage
#   zohara-channel list             # show all available channels

set -euo pipefail

CHANNEL_FILE="/etc/zohara/channel"
PACMAN_CONF="/etc/pacman.conf"
REPO_BASE="https://github.com/Zohaib8090/zohara-packages/releases"

repo_name() {
    case "$1" in
        stable) echo "zohara-stable" ;;
        beta)   echo "zohara-beta" ;;
        alpha)  echo "zohara-alpha" ;;
        *) echo "ERROR: unknown channel '$1'" >&2; return 1 ;;
    esac
}

current_channel() {
    if [ -f "$CHANNEL_FILE" ]; then
        cat "$CHANNEL_FILE"
    else
        echo "stable"
    fi
}

show_current() {
    local cur="$(current_channel)"
    printf "Current channel: %s  (repo: [%s])\n" "$cur" "$(repo_name "$cur")"
}

write_pacman_repo() {
    local target="$1"
    local repo_section="[${target}]"

    # Ensure the header line is enabled (uncommented), then ensure the
    # SigLevel + Server lines under it are also enabled. We do this with
    # simple sed: uncomment the lines that begin with #<expected>
    # immediately following the section header.

    # 1) Enable the section header
    sed -i "s|^#\[${target}\]|\[${target}\]|" "$PACMAN_CONF" 2>/dev/null || true
    # 2) Within the block (until the next blank line or next [section]),
    #    uncomment SigLevel = ... and Server = ... lines that match.
    #    Use awk for state-machine clarity.
    awk -v section="$repo_section" '
        /^\[.*\]$/ {
            in_block = ($0 == section)
        }
        in_block && /^#SigLevel[[:space:]]*=.*/ {
            sub(/^#/, "")
        }
        in_block && /^#Server[[:space:]]*=.*/ {
            sub(/^#/, "")
        }
        { print }
    ' "$PACMAN_CONF" > "$PACMAN_CONF.tmp" && mv "$PACMAN_CONF.tmp" "$PACMAN_CONF"
}

disable_other_repos() {
    # Comment out any [zohara-*] section other than the one we just enabled.
    local keep="$1"
    local cur_section=""
    awk -v keep="$keep" '
        /^\[.*\]$/ {
            cur_section = $0
            gsub(/[\[\]]/, "", cur_section)
            if (cur_section ~ /^zohara-/ && cur_section != keep) {
                # Rewrite this section header back to commented
                print "#[" cur_section "]"
                commenting = 1
                next
            } else if (cur_section ~ /^zohara-/) {
                commenting = 0
                print
                next
            } else {
                commenting = 0
                print
                next
            }
        }
        commenting && /^SigLevel[[:space:]]*=/ { print "#" $0; next }
        commenting && /^Server[[:space:]]*=/   { print "#" $0; next }
        { print }
    ' "$PACMAN_CONF" > "$PACMAN_CONF.tmp" && mv "$PACMAN_CONF.tmp" "$PACMAN_CONF"
}

set_channel() {
    local new="$1"
    local repo
    repo="$(repo_name "$new")" || exit 1

    # 1) Persist the choice
    mkdir -p "$(dirname "$CHANNEL_FILE")"
    echo "$new" > "$CHANNEL_FILE"

    # 2) Update pacman.conf
    write_pacman_repo "$repo"
    disable_other_repos "$repo"

    # 3) Refresh the package database
    echo "[+] Refreshing package databases for channel '$new'..."
    if pacman -Sy 2>&1 | tail -5; then
        echo "[✓] Switched to channel '$new' (repo [$repo])."
    else
        echo "[!] pacman -Sy failed. The repo URL may not have zohara.db yet."
        echo "    This is normal on a fresh install where no package has been published yet."
        echo "    Run 'zohara-channel list' to see channel status."
    fi
}

list_channels() {
    echo "Available Zohara OS update channels:"
    for ch in stable beta alpha; do
        local repo
        repo="$(repo_name "$ch")"
        local url="${REPO_BASE}/$( [ "$ch" = "stable" ] && echo "stable" || echo "channel-$ch" )/download/zohara.db"
        local status="(unknown)"
        # Probe: does the channel have a published zohara.db?
        if curl -sI -o /dev/null -w "%{http_code}" --max-time 5 "$url" 2>/dev/null | grep -q '^200$'; then
            status="available"
        else
            status="no packages yet"
        fi
        local marker=""
        [ "$ch" = "$(current_channel)" ] && marker=" *"
        printf "  %-7s [%s]  %-20s%s\n" "$ch" "$repo" "$status" "$marker"
    done
}

case "${1:-}" in
    "")            show_current ;;
    "list")        list_channels ;;
    "set")
        if [ -z "${2:-}" ]; then
            echo "Usage: zohara-channel set <stable|beta|alpha>" >&2
            exit 1
        fi
        set_channel "$2"
        ;;
    "current")     current_channel ;;
    *)
        echo "Usage: zohara-channel [list|set <channel>|current]" >&2
        exit 1
        ;;
esac
