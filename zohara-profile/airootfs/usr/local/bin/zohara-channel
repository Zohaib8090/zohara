#!/usr/bin/env bash
# zohara-channel -- switch between stable/beta/alpha update channels
#
# The Zohara Packages repo at https://github.com/Zohaib8090/zohara-packages
# has three release channels, each as a separate GitHub release with its own
# zohara.db. There is a single [zohara] section in /etc/pacman.conf (see
# customize_airootfs.sh for why it's one repo name, not one per channel);
# this script rewrites its Server= line to the selected channel's release
# and enables the section if it's still commented out.
#
# Usage:
#   zohara-channel                  # show current channel
#   zohara-channel set stable       # default; LTS / production
#   zohara-channel set beta         # weekly builds, may be buggy
#   zohara-channel set alpha        # daily / manual, expect breakage
#   zohara-channel list             # show all available channels

set -euo pipefail

CHANNEL_FILE="/etc/zohara/channel"
PACMAN_CONF="/etc/pacman.conf"
REPO_BASE="https://github.com/Zohaib8090/zohara-packages/releases/download"

release_tag() {
    case "$1" in
        stable) echo "stable" ;;
        beta)   echo "channel-beta" ;;
        alpha)  echo "channel-alpha" ;;
        *) echo "ERROR: unknown channel '$1'" >&2; return 1 ;;
    esac
}

current_channel() {
    if [ -f "$CHANNEL_FILE" ]; then
        cat "$CHANNEL_FILE"
    else
        echo "stable"
    fi
}

show_current() {
    local cur="$(current_channel)"
    printf "Current channel: %s  (%s)\n" "$cur" "$REPO_BASE/$(release_tag "$cur")"
}

# Rewrite the [zohara] section in place: uncomment the header + SigLevel +
# Server lines if needed, and point Server at the given tag's release.
set_channel() {
    local new="$1" tag
    tag="$(release_tag "$new")" || exit 1

    if ! grep -qE '^#?\[zohara\]$' "$PACMAN_CONF"; then
        echo "ERROR: no [zohara] section found in $PACMAN_CONF" >&2
        echo "       (expected one, written disabled, by customize_airootfs.sh)" >&2
        exit 1
    fi

    awk -v tag="$tag" -v base="$REPO_BASE" '
        /^#?\[zohara\]$/               { in_block = 1; print "[zohara]"; next }
        in_block && /^#?SigLevel[[:space:]]*=/ { print "SigLevel = Optional TrustAll"; next }
        in_block && /^#?Server[[:space:]]*=/    { print "Server = " base "/" tag; in_block = 0; next }
        { print }
    ' "$PACMAN_CONF" > "$PACMAN_CONF.tmp" && mv "$PACMAN_CONF.tmp" "$PACMAN_CONF"

    mkdir -p "$(dirname "$CHANNEL_FILE")"
    echo "$new" > "$CHANNEL_FILE"

    echo "[+] Refreshing package databases for channel '$new'..."
    if pacman -Sy 2>&1 | tail -5; then
        echo "[OK] Switched to channel '$new'."
    else
        echo "[!] pacman -Sy failed. The channel may not have a published zohara.db yet."
        echo "    Run 'zohara-channel list' to probe every channel's status."
    fi
}

list_channels() {
    echo "Available Zohara OS update channels:"
    for ch in stable beta alpha; do
        local tag url status marker=""
        tag="$(release_tag "$ch")"
        url="$REPO_BASE/$tag/zohara.db"
        if curl -sIL -o /dev/null -w "%{http_code}" --max-time 5 "$url" 2>/dev/null | grep -q '^200$'; then
            status="available"
        else
            status="no packages yet"
        fi
        [ "$ch" = "$(current_channel)" ] && marker=" *"
        printf "  %-7s [%s]  %-20s%s\n" "$ch" "$tag" "$status" "$marker"
    done
}

case "${1:-}" in
    "")            show_current ;;
    "list")        list_channels ;;
    "set")
        if [ -z "${2:-}" ]; then
            echo "Usage: zohara-channel set <stable|beta|alpha>" >&2
            exit 1
        fi
        set_channel "$2"
        ;;
    "current")     current_channel ;;
    *)
        echo "Usage: zohara-channel [list|set <channel>|current]" >&2
        exit 1
        ;;
esac
