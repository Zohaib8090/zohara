#!/usr/bin/env bash
# Zohara OS Theme & Layout Switcher

# Present GUI dialog to select theme preset
PRESET=$(kdialog --title "Zohara OS Theme Switcher" --combobox "Select your desired interface layout and theme:" "Win11" "Win10" "Win8" "macOS" "Liquid Glass" "KDE Native" --default "Win11")

if [ $? -ne 0 ] || [ -z "$PRESET" ]; then
    exit 0
fi

# Define Layout Source Directory
LAYOUTS_DIR="$HOME/.config/zohara-layouts"
mkdir -p "$LAYOUTS_DIR"

apply_theme() {
    local global_theme="$1"
    local gtk_theme="$2"
    local appletsrc_file="$3"
    local kvantum_theme="$4"
    
    # 1. Apply Global Theme (Plasma style, colors, window decorations)
    lookandfeeltool -a "$global_theme"
    
    # 2. Apply GTK Theme
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
    
    # 3. Apply Kvantum Theme if specified
    if [ -n "$kvantum_theme" ]; then
        kvantummanager --set "$kvantum_theme"
    fi
    
    # 4. Swap Layout config (plasma-org.kde.plasma.desktop-appletsrc)
    if [ -f "$LAYOUTS_DIR/$appletsrc_file" ]; then
        cp -f "$LAYOUTS_DIR/$appletsrc_file" "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
    else
        echo "Layout file $appletsrc_file not found in $LAYOUTS_DIR. Using current layout."
    fi
    
    # 5. Restart Plasma Shell to apply changes instantly
    kdialog --title "Applying Theme" --passivepopup "Applying $PRESET preset... Your screen may flicker." 3
    plasmashell --replace &
    disown
}

case "$PRESET" in
    "Win11")
        apply_theme "org.kde.breeze.desktop" "Breeze" "win11-appletsrc" "Fluent"
        ;;
    "Win10")
        apply_theme "org.kde.breezedark.desktop" "Breeze-Dark" "win10-appletsrc" ""
        ;;
    "Win8")
        apply_theme "org.kde.breeze.desktop" "Breeze" "win8-appletsrc" ""
        ;;
    "macOS")
        # Placeholder for WhiteSur if installed later, falling back to Breeze for now
        apply_theme "org.kde.breeze.desktop" "Breeze" "macos-appletsrc" "Materia"
        ;;
    "Liquid Glass")
        apply_theme "org.kde.breezedark.desktop" "Breeze-Dark" "liquidglass-appletsrc" "MateriaDark"
        ;;
    "KDE Native")
        apply_theme "org.kde.breezedark.desktop" "Breeze-Dark" "native-appletsrc" ""
        ;;
esac

kdialog --title "Zohara OS" --msgbox "$PRESET theme applied successfully!"
