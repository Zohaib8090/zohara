#!/usr/bin/env python3
"""
Zohara OS Welcome App
─────────────────────
Auto-launches on desktop load. Offers Install, Migrate, or Try.
Handles root/non-root gracefully (no pkexec on live USB).
"""
import sys
import os
import subprocess
import logging
from PyQt5.QtWidgets import (QApplication, QWidget, QVBoxLayout, QPushButton,
                              QLabel, QMessageBox)
from PyQt5.QtCore import Qt
from PyQt5.QtGui import QFont

# Set up logging to a file for debugging
LOG_FILE = '/tmp/zohara-welcome.log'
logging.basicConfig(
    filename=LOG_FILE,
    level=logging.DEBUG,
    format='%(asctime)s [%(levelname)s] %(message)s'
)
log = logging.getLogger('zohara-welcome')


def launch(cmd_list, description="process"):
    """
    Launch a subprocess safely.
    - If we're already root → run directly (no pkexec).
    - If we're a normal user → prepend pkexec.
    - Returns True on success, False on failure.
    """
    is_root = os.geteuid() == 0
    if not is_root:
        cmd_list = ['pkexec'] + cmd_list

    log.info(f"Launching {description}: {' '.join(cmd_list)}")
    try:
        proc = subprocess.Popen(
            cmd_list,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        # Wait briefly to see if it crashes immediately
        try:
            retcode = proc.wait(timeout=2)
            if retcode != 0:
                stderr = proc.stderr.read().decode(errors='replace')
                log.error(f"{description} exited immediately with code {retcode}: {stderr}")
                return False, stderr
        except subprocess.TimeoutExpired:
            # Still running after 2s — that's good, it launched successfully
            log.info(f"{description} is running (pid={proc.pid})")
            return True, ""
        return True, ""
    except FileNotFoundError as e:
        log.error(f"{description} not found: {e}")
        return False, str(e)
    except Exception as e:
        log.error(f"Failed to launch {description}: {e}")
        return False, str(e)


class WelcomeWindow(QWidget):
    def __init__(self):
        super().__init__()
        log.info("Welcome window initialized")
        self.initUI()

    def initUI(self):
        self.setWindowTitle('Welcome to Zohara OS')
        self.setFixedSize(600, 420)
        self.setStyleSheet("background-color: #1e1e2e; color: #cdd6f4;")

        layout = QVBoxLayout()
        layout.setAlignment(Qt.AlignCenter)
        layout.setSpacing(20)

        title = QLabel('Welcome to Zohara OS')
        title.setFont(QFont('Inter', 24, QFont.Bold))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)

        subtitle = QLabel('What would you like to do?')
        subtitle.setFont(QFont('Inter', 14))
        subtitle.setAlignment(Qt.AlignCenter)
        layout.addWidget(subtitle)

        btn_layout = QVBoxLayout()
        btn_layout.setSpacing(15)

        is_live = os.path.exists('/run/archiso')

        btn_install = QPushButton('Install Zohara OS')
        btn_install.setStyleSheet(self.get_btn_style('#89b4fa'))
        btn_install.setCursor(Qt.PointingHandCursor)
        btn_install.clicked.connect(self.install_os)

        btn_migrate = QPushButton('Migrate from another OS')
        btn_migrate.setStyleSheet(self.get_btn_style('#a6e3a1'))
        btn_migrate.setCursor(Qt.PointingHandCursor)
        btn_migrate.clicked.connect(self.migrate_os)

        btn_users = QPushButton('👤  Manage Users')
        btn_users.setStyleSheet(self.get_btn_style('#cba6f7'))
        btn_users.setCursor(Qt.PointingHandCursor)
        btn_users.clicked.connect(self.manage_users)

        btn_update = QPushButton('🔄  Update System')
        btn_update.setStyleSheet(self.get_btn_style('#f9e2af'))
        btn_update.setCursor(Qt.PointingHandCursor)
        btn_update.clicked.connect(self.update_system)

        btn_try = QPushButton('Try Zohara OS' if is_live else 'Close')
        btn_try.setStyleSheet(self.get_btn_style('#f38ba8'))
        btn_try.setCursor(Qt.PointingHandCursor)
        btn_try.clicked.connect(self.try_os)

        if is_live:
            btn_layout.addWidget(btn_install)
        btn_layout.addWidget(btn_migrate)
        if not is_live:
            btn_layout.addWidget(btn_users)
            btn_layout.addWidget(btn_update)
        btn_layout.addWidget(btn_try)

        layout.addLayout(btn_layout)

        # Debug info label (small, at bottom)
        self.status_label = QLabel('')
        self.status_label.setStyleSheet("color: #585b70; font-size: 10px;")
        self.status_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.status_label)

        self.setLayout(layout)

    def get_btn_style(self, bg_color):
        return f"""
            QPushButton {{
                background-color: {bg_color};
                color: #1e1e2e;
                border-radius: 8px;
                padding: 12px;
                font-size: 16px;
                font-weight: bold;
            }}
            QPushButton:hover {{
                background-color: {bg_color}cc;
            }}
        """

    def install_os(self):
        log.info("User clicked: Install Zohara OS")
        self.status_label.setText("Launching installer...")
        ok, err = launch(['calamares'], "Calamares Installer")
        if ok:
            self.close()
        else:
            self.show_error("Could not launch the installer.", err)

    def migrate_os(self):
        log.info("User clicked: Migrate from another OS")
        self.status_label.setText("Launching migration tool...")
        ok, err = launch(['/usr/local/bin/zohara-migrate'], "Migration Tool")
        if ok:
            self.close()
        else:
            self.show_error("Could not launch the Migration Tool.", err)

    def manage_users(self):
        log.info("User clicked: Manage Users")
        self.status_label.setText("Launching User Manager...")
        ok, err = launch(['/usr/local/bin/zohara-usermgr'], "User Manager")
        if not ok:
            self.show_error("Could not launch the User Manager.", err)

    def update_system(self):
        log.info("User clicked: Update System")
        self.status_label.setText("Launching System Updater...")
        ok, err = launch(['/usr/local/bin/zohara-update'], "System Updater")
        if not ok:
            self.show_error("Could not launch the System Updater.", err)

    def try_os(self):
        log.info("User clicked: Try Zohara OS")
        self.close()

    def show_error(self, message, details=""):
        log.error(f"Showing error to user: {message} | {details}")
        self.status_label.setText(f"Error: {message}")
        full_msg = message
        if details:
            full_msg += f"\n\nDetails:\n{details}"
        full_msg += f"\n\nDebug log saved to: {LOG_FILE}"
        QMessageBox.critical(self, "Launch Error", full_msg)


if __name__ == '__main__':
    log.info("=== Zohara Welcome App starting ===")
    log.info(f"Running as UID={os.geteuid()}, Live USB={os.path.exists('/run/archiso')}")
    app = QApplication(sys.argv)
    ex = WelcomeWindow()
    ex.show()
    sys.exit(app.exec_())
