#!/usr/bin/env bash
# Zohara OS Offline Kernel Installer
# Calamares unpackfs copies the squashfs, but the kernel is on the boot partition.
# This script finds the target disk and copies the kernel over offline.

TARGET=$(ls -d /tmp/calamares-root-* 2>/dev/null | head -1)

if [ -z "$TARGET" ]; then
    echo "Error: Could not find Calamares target directory."
    exit 1
fi

mkdir -p "$TARGET/boot"

# --- ZOHARA OFFLINE INSTALL CLEANUP ---
# Because we used unpackfs (which clones the live USB environment),
# we MUST remove live-cd specific files from the installed system.
# Otherwise, mkinitcpio will try to build live USB hooks,
# and systemd will try to autologin as the live user.

echo "Cleaning up live-environment artifacts..."

rm -f "$TARGET/etc/mkinitcpio.conf.d/archiso.conf"
rm -f "$TARGET/etc/systemd/system/choose-mirror.service"
rm -f "$TARGET/etc/systemd/system/etc-pacman.d-gnupg.mount"
rm -f "$TARGET/etc/systemd/system/livecd-alsa-unmuter.service"
rm -f "$TARGET/etc/systemd/system/livecd-talk.service"
rm -f "$TARGET/etc/systemd/system/pacman-init.service"
rm -rf "$TARGET/etc/systemd/system/getty@tty1.service.d"

# Also remove them from multi-user.target.wants if they exist
rm -f "$TARGET/etc/systemd/system/multi-user.target.wants/choose-mirror.service"
rm -f "$TARGET/etc/systemd/system/multi-user.target.wants/pacman-init.service"
rm -f "$TARGET/etc/systemd/system/multi-user.target.wants/livecd-alsa-unmuter.service"
rm -f "$TARGET/etc/systemd/system/sysinit.target.wants/etc-pacman.d-gnupg.mount"

# Remove Live USB SDDM autologin configurations so the installed OS prompts for the created user
rm -f "$TARGET/etc/sddm.conf.d/99-autologin.conf"
rm -f "$TARGET/etc/sddm.conf.d/99-root-login.conf"

echo "Cleanup complete."

# Archiso removes /boot/vmlinuz-linux-zen from the squashfs (airootfs).
# However, the 'linux-zen' package also places a copy of the kernel in 
# /usr/lib/modules/<version>/vmlinuz. Since this is inside the squashfs,
# Calamares unpacks it into the target system.
# We just need to copy it from there to /boot/vmlinuz-linux-zen so mkinitcpio can find it.

KERNEL_SRC=$(ls "$TARGET"/usr/lib/modules/*/vmlinuz 2>/dev/null | head -n 1)

if [ -n "$KERNEL_SRC" ] && [ -f "$KERNEL_SRC" ]; then
    cp "$KERNEL_SRC" "$TARGET/boot/vmlinuz-linux-zen"
    echo "Kernel successfully copied from modules directory to /boot/vmlinuz-linux-zen."
    exit 0
else
    echo "Error: Could not find vmlinuz in target modules directory. Kernel copy failed."
    exit 1
fi
