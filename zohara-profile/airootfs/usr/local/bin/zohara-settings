SURFACE, BORDER = "#313244", "#45475a"
TEXT, SUBTEXT = "#cdd6f4", "#a6adc8"
BLUE, GREEN, RED, YELLOW, PURPLE, TEAL = (
    "#89b4fa", "#a6e3a1", "#f38ba8", "#f9e2af", "#cba6f7", "#94e2d5"
)

