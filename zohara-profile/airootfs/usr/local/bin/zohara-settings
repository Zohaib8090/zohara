             padding:8px 12px; color:{TEXT}; font-size:13px; }}
QLineEdit:focus {{ border-color:{BLUE}; }}
QListWidget {{ background:{SURFACE}; border:1px solid {BORDER}; border-radius:8px; padding:4px; }}
