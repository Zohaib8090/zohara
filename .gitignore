# Rust / Cargo
**/target/
**/*.rs.bk

# Cloned standalone repos (zohara-settings etc. are pulled at build time)
zohara-settings-rs/
# makepkg output from building zohara-store-rs locally
zohara-store-rs/*.pkg.tar.zst
zohara-store-rs/pkg/
zohara-store-rs/src/*.o

# Archiso build directories
work/
out/
*.iso

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
localrepo/
pkg-cache/

# AI / Agent framework directories (local tooling only, not for repo)
.agent/
.agents/
.gemini/
.gsd/
.GSD-STYLE.md
.AGENT_STATE.md
GSD-STYLE.md

# Environment / Secrets
.env
.env.local

# Old builds staged the Rust binaries into the overlay. They now ship as pacman packages from
# /opt/localrepo, and build-iso.sh deletes any stale copies here (they would make pacstrap fail
# with "exists in filesystem"). Kept ignored so a leftover copy is never committed.
zohara-profile/airootfs/usr/bin/zohara-settings
zohara-profile/airootfs/usr/bin/zohara-store

# Large build logs and the prebuilt Docker image tarball (multi-GB, not source).
docker-*.log
zohara-builder-image.tar
.hermes/
