[Desktop Entry]
Name=Software Store
Comment=Discover and install applications on Zohara OS
Exec=zohara-store %U
Icon=zohara-store
Terminal=false
Type=Application
Categories=System;Settings;
StartupNotify=true
MimeType=x-scheme-handler/appstream;application/vnd.flatpak.ref;application/vnd.appimage;application/x-iso9660-appimage;
