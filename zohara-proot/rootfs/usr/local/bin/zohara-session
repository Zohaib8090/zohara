#!/bin/bash
# Starts the Zohara desktop inside proot. Termux's `zohara` command runs this
# after starting the X server (Termux:X11) and PulseAudio.
export DISPLAY="${DISPLAY:-:0}"
export PULSE_SERVER="${PULSE_SERVER:-tcp:127.0.0.1:4713}"
export XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=KDE KDE_FULL_SESSION=true
export QT_QPA_PLATFORM=xcb GDK_BACKEND=x11
# No GPU access in proot: draw with the CPU.
export LIBGL_ALWAYS_SOFTWARE=1 KWIN_COMPOSE=N
export ZOHARA_PROOT=1

if ! command -v startplasma-x11 >/dev/null; then
    echo "The Plasma X11 session isn't installed in this Zohara build." >&2
    exit 1
fi
exec dbus-run-session startplasma-x11
